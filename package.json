{
  "name": "steam-hours-boost-multi-account",
  "version": "1.2.0",
  "description": "สคริปต์ Node.js สำหรับดันชั่วโมงเกม Steam หลายบัญชีพร้อมกัน มีระบบหน่วงเวลา รองรับ Steam Guard อัตโนมัติ/กรอกมือ และ reconnect อัตโนมัติ",
  "main": "index.js",
  "private": true,
  "author": "Nozeed",
  "license": "MIT",
  "keywords": [
    "steam",
    "steam-idle",
    "steam-boost",
    "hours-boost",
    "multi-account",
    "steam-farming",
    "node-steam"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "check": "node --check index.js && node --check settings.example.js && node --check ecosystem.config.js",
    "dry-run": "node index.js --dry-run",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:logs": "pm2 logs steam-boost"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "steam-totp": "^2.1.2",
    "steam-user": "^5.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nozeed/Steam-Hours-Boost-Multi-Account-By-Nozeed.git"
  },
  "bugs": {
    "url": "https://github.com/Nozeed/Steam-Hours-Boost-Multi-Account-By-Nozeed/issues"
  },
  "homepage": "https://github.com/Nozeed/Steam-Hours-Boost-Multi-Account-By-Nozeed#readme"
}
